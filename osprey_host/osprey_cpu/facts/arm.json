{
  "isa": "arm64",
  "libm_exact": true,
  "gcc_routes_pow": true,
  "vector_math_needs_gcc": false,
  "default_profile": {"gcc": "native-vector-math", "other": "native-vector-math"},
  "default_vector_isa": "neon",
  "fusion_host": {
    "neon": {"regs_base": 0, "regs_file": 32, "launch_us": null, "plane_us_per_byte": null, "local_over_plane": null}
  },
  "host_flags": {
    "native": ["-mcpu=native"],
    "portable": [],
    "vector_math": {
      "gcc": {"native-vector-math": ["-fno-trapping-math", "-fno-thread-jumps", "-DAETHER_HOST_VECTOR_MATH"]},
      "other": {"native-vector-math": []}
    },
    "masked_call": false
  }
}
