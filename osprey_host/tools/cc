#!/bin/sh
# Linker wrapper: rustc exports every C-level symbol of the Rust crates it links, so the door's own functions would leave
# through the library. The export list rustc hands to the linker is cut to the one entry point before linking.
#   macOS: the list is the file named by -exported_symbols_list; it keeps only the line `_osprey_v1`.
#   Linux: the list is the GNU ld version script named by --version-script=; it is rewritten to export `osprey_v1` alone, or
#   nothing when the build does not define it (a cdylib linked without the door feature): lld refuses a global it cannot find.
# To check the exported list of a Linux build:  nm -g --defined-only target/debug/libosprey_cpu.so   (one line: osprey_v1)
for a in "$@"; do
  case "$prev" in -Wl,-exported_symbols_list) f=${a#-Wl,}; grep -x '_osprey_v1' "$f" > "$f.cut" && mv "$f.cut" "$f" ;; esac
  case "$a" in -Wl,--version-script=*) f=${a#-Wl,--version-script=}
    if grep -q osprey_v1 "$f"; then keep='global: osprey_v1; '; else keep=''; fi
    printf '{ %slocal: *; };\n' "$keep" > "$f" ;; esac
  prev=$a
done
exec "${REAL_CC:-cc}" "$@"
